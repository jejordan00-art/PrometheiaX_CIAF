{
  "info": {
    "_postman_id": "prometheiax-ciaf-collection-v1",
    "name": "PrometheiaX — API REST CIAF (John Edison Jordan & Laura Sánchez)",
    "description": "Colección completa de pruebas para el Taller Evaluativo Final de Arquitectura Cliente-Servidor (CIAF). Incluye pruebas de códigos HTTP 200, 201, 400 y 404, y cálculo de tarifa N=10 (20%).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Casos Exitosos (200 OK y 201 Created)",
      "item": [
        {
          "name": "GET /api/turnos - Listar Todas las Solicitudes (200 OK)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/turnos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "turnos"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Respuesta contiene arreglo de datos', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.exito).to.eql(true);",
                  "    pm.expect(Array.isArray(json.datos)).to.eql(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /api/turnos/1 - Consultar Turno Existente por ID (200 OK)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/turnos/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "turnos", "1"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Retorna el ID correcto', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.datos.id).to.eql('1');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /api/turnos - Crear Solicitud con Prioridad y Recargo 20% (201 Created)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estudiante\": \"Laura Ximena Sánchez\",\n  \"tipoServicio\": \"Asesoría académica\",\n  \"tema\": \"Arquitectura de software por capas\",\n  \"fechaHora\": \"2026-12-05T10:00:00\",\n  \"precioBase\": 200000,\n  \"prioritario\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/turnos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "turnos"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Cálculo exacto regla N=10 (20% recargo)', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.datos.parametroN).to.eql(10);",
                  "    pm.expect(json.datos.porcentajeRecargo).to.eql(20);",
                  "    pm.expect(json.datos.valorRecargo).to.eql(40000);",
                  "    pm.expect(json.datos.totalPagar).to.eql(240000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /api/turnos - Crear Solicitud Normal sin Recargo (201 Created)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estudiante\": \"John Edison Jordan\",\n  \"tipoServicio\": \"Tutoría personalizada\",\n  \"tema\": \"Diseño de Base de Datos y Normalización\",\n  \"fechaHora\": \"2026-12-06T14:30:00\",\n  \"precioBase\": 150000,\n  \"prioritario\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/turnos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "turnos"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Sin recargo prioritario (totalPagar = precioBase)', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.datos.valorRecargo).to.eql(0);",
                  "    pm.expect(json.datos.totalPagar).to.eql(150000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Casos de Error de Validación (400 Bad Request)",
      "item": [
        {
          "name": "POST /api/turnos - Error: Campos Obligatorios Faltantes (400 Bad Request)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estudiante\": \"\",\n  \"tipoServicio\": \"Tutoría\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/turnos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "turnos"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('Mensaje de error descriptivo', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.exito).to.eql(false);",
                  "    pm.expect(json.detalles.length).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /api/turnos - Error: precioBase Menor o Igual a Cero (400 Bad Request)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estudiante\": \"Laura Sánchez\",\n  \"tipoServicio\": \"Asesoría\",\n  \"tema\": \"Pruebas\",\n  \"fechaHora\": \"2026-12-05T10:00:00\",\n  \"precioBase\": -50000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/turnos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "turnos"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('Señala que precioBase debe ser mayor a cero', function () {",
                  "    var raw = pm.response.text();",
                  "    pm.expect(raw.toLowerCase()).to.include('preciobase');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Casos de Recurso No Encontrado (404 Not Found)",
      "item": [
        {
          "name": "GET /api/turnos/999999 - Consultar ID Inexistente (404 Not Found)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/turnos/999999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "turnos", "999999"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 404 Not Found', function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "pm.test('Mensaje JSON indica no encontrado', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.exito).to.eql(false);",
                  "    pm.expect(json.error).to.include('404');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
