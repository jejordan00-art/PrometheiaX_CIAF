# Archivo de variables de entorno para PrometheiaX
# Taller Evaluativo Final - CIAF Arquitectura Cliente-Servidor

# Puerto del servidor web y API REST
PORT=3000

# Parámetro N del equipo según la lista oficial de asistencia CIAF
# Regla: Se ordenan alfabéticamente por apellido los integrantes del equipo.
# N corresponde al número de lista oficial del primer integrante.
# Ejemplo: Si el primer integrante es el #7 en la lista oficial, entonces EQUIPO_N=7
# Porcentaje de recargo = N * 2%
EQUIPO_N=7
